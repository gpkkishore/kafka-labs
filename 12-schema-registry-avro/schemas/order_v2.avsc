{
  "type": "record",
  "name": "Order",
  "namespace": "kinaction.orders",
  "doc": "Version 2: adds an optional coupon and a status enum (both have DEFAULTS => backward compatible)",
  "fields": [
    {"name": "order_id",  "type": "string"},
    {"name": "customer",  "type": "string"},
    {"name": "amount",    "type": "double", "doc": "total in USD"},
    {"name": "created_at","type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "coupon",    "type": ["null", "string"], "default": null},
    {"name": "status",    "type": {"type": "enum", "name": "Status", "symbols": ["CREATED", "PAID", "SHIPPED"]}, "default": "CREATED"}
  ]
}
